{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "scripts/*.mjs",
    "packages/*/src/**/*.mjs",
    "packages/*/bin/*.mjs",
    "packages/spectrail/index.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "**/node_modules/**"
  ]
}
